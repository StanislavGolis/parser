# ── URL API (бэкенд FastAPI) ─────────────────────────────────────
# Для браузера (клиентская часть). Пустая строка = тот же origin
# (в проде Nginx проксирует /api на сервис api).
NEXT_PUBLIC_API_BASE=http://localhost:8000

# Для серверного рендеринга (SSR). В Docker-сети: http://api:8000
API_BASE_SERVER=http://localhost:8000
