# ═══════════════════════════════════════════════════════════════════
#  КОПИЯ ДЛЯ ЛОКАЛЬНОЙ РАЗРАБОТКИ/ДЕПЛОЯ: скопируйте в .env и заполните
# ═══════════════════════════════════════════════════════════════════

# ── База данных ─────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://user:pass@localhost:5432/parser

# ── Локальное хранилище (кэш) ──────────────────────────────────
STORAGE_PATH=./storage/media

# ── Парсинг ─────────────────────────────────────────────────────
PARSE_INTERVAL=30
BOARDS_TO_PARSE=["b", "pr"]
REQUEST_DELAY=0.5

# Ограничения
MAX_FILES_PER_POST=5
MAX_FILE_SIZE=104857600

# Сверка данных (reconciliation): период в минутах, 0 = только при старте
RECONCILE_MINUTES=60

# ── Backblaze B2 (приватный бакет) ──────────────────────────────
B2_KEY_ID=
B2_APPLICATION_KEY=
B2_BUCKET_NAME=
B2_ENDPOINT=https://s3.us-west-000.backblazeb2.com
B2_SIGNED_URL_TTL=3600