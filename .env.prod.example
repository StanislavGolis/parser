# ─────────────────────────────────────────────────────────────────
#  Шаблон переменных для production-стека (docker-compose.prod.yml).
#  Скопируйте в .env рядом с compose-файлом (или на VPS) и заполните.
#
#  Композ подхватывает .env из корня репозитория автоматически.
# ─────────────────────────────────────────────────────────────────

# Публичный HTTP-порт сайта (локально можно 8081, на VPS — 80)
HTTP_PORT=80

# ── PostgreSQL (креды; хост и порт внутри сети задаёт compose) ──
POSTGRES_DB=parser
POSTGRES_USER=parser
POSTGRES_PASSWORD=change-me-strong-password

# ── Объектное хранилище S3 (Timeweb Cloud) ───────────────────────
# Значения из панели Timeweb (S3 URL / бакет / Access Key / Secret Key / регион).
S3_URL=https://s3.twcstorage.ru
S3_REGION=ru-1
S3_BUCKET=your-bucket-name
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_ADDRESSING_STYLE=path
S3_SIGNED_URL_TTL=3600
# Отдача медиа: proxy — через API (анонимно), presigned — прямые ссылки на бакет
MEDIA_DELIVERY=proxy

# ── API сайта ─────────────────────────────────────────────────────
# Токен для админ-эндпоинтов (POST /api/v1/admin/...)
# Сгенерировать: openssl rand -hex 32
ADMIN_TOKEN=change-me
# Логировать SQL-запросы (echo у SQLAlchemy): 0 — выключено (в проде обязательно 0)
SQL_ECHO=0
# Cookie сессии только по HTTPS: на VPS с SSL поставьте 1, локально без сертификата — 0
SESSION_COOKIE_SECURE=0
# Лимит публичных запросов в минуту на один IP
API_RATE_LIMIT=60
# Разрешённые CORS-источники (не критично: фронт ходит через тот же origin)
API_CORS_ORIGINS=http://localhost
# Период пересчёта индекса популярности, в минутах
POPULARITY_RECALC_MINUTES=5

# ── Парсер ────────────────────────────────────────────────────────
# Доски в формате JSON-массива
BOARDS_TO_PARSE=["b"]
# Задержка между запросами к форуму (защита от бана), сек
REQUEST_DELAY=0.5
# Коммит БД каждые N файлов внутри треда: файлы видны на сайте по мере скачивания,
# сбой теряет максимум N файлов (0 — коммит только после треда)
DB_COMMIT_EVERY_FILES=25
# Пауза между циклами парсинга, сек
PARSE_INTERVAL=60
# Максимальный размер файла, байт
MAX_FILE_SIZE=104857600
# Период сверки БД ↔ хранилище (reconciliation), мин (0 = только при старте)
RECONCILE_MINUTES=60
# Гигиена обхода: сколько проходов каталога подряд треда не было в каталоге → is_active=false
DEAD_THREAD_AFTER_MISSES=3
# Гигиена обхода: тред не сканировался дольше N часов → «просрочен» (чип в админке)
STALE_SCAN_HOURS=24
# Бюджет цикла: после N минут фаза B прерывается, остаток очереди — в следующем цикле (0 = без лимита)
PARSE_CYCLE_BUDGET_MINUTES=30
# Параллельные загрузки внутри треда (1 = строго последовательно)
MAX_PARALLEL_DOWNLOADS=2
# Ограничение памяти под «предзагрузку» пачки файлов, байт
PREFETCH_MAX_BYTES=67108864
# Параллельная выгрузка в S3 внутри треда: по умолчанию 1 (наш S3-эндпоинт
# троттлит одновременные загрузки — замер: 10.9 МБ/с против 3.0 МБ/с)
MAX_PARALLEL_UPLOADS=1
