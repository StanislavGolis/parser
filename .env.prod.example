# ─────────────────────────────────────────────────────────────────
#  Шаблон переменных для production-стека (docker-compose.prod.yml).
#  Скопируйте в .env рядом с compose-файлом (или на VPS) и заполните.
#
#  Композ подхватывает .env из корня репозитория автоматически.
# ─────────────────────────────────────────────────────────────────

# Публичный HTTP-порт сайта (локально можно 8081, на VPS — 80)
HTTP_PORT=80

# ── PostgreSQL (креды; хост и порт внутри сети задаёт compose) ──
POSTGRES_DB=parser
POSTGRES_USER=parser
POSTGRES_PASSWORD=change-me-strong-password

# ── Объектное хранилище S3 (Timeweb Cloud) ───────────────────────
# Значения из панели Timeweb (S3 URL / бакет / Access Key / Secret Key / регион).
S3_URL=https://s3.twcstorage.ru
S3_REGION=ru-1
S3_BUCKET=your-bucket-name
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_ADDRESSING_STYLE=path
S3_SIGNED_URL_TTL=3600
# Отдача медиа: proxy — через API (анонимно), presigned — прямые ссылки на бакет
MEDIA_DELIVERY=proxy

# ── API сайта ─────────────────────────────────────────────────────
# Токен для админ-эндпоинтов (POST /api/v1/admin/...)
# Сгенерировать: openssl rand -hex 32
ADMIN_TOKEN=change-me
# Логировать SQL-запросы (echo у SQLAlchemy): 0 — выключено (в проде обязательно 0)
SQL_ECHO=0
# Cookie сессии только по HTTPS: на VPS с SSL поставьте 1, локально без сертификата — 0
SESSION_COOKIE_SECURE=0
# Лимит публичных запросов в минуту на один IP
# Лимиты на IP (запросов в минуту, 0 — выключить).
# Два независимых лимита: JSON-API (ленты, детали) и медиа-файлы (превью/оригиналы).
# Медиа-лимит обязательно выше: одна страница галереи = десятки запросов превью.
API_RATE_LIMIT=900
# «Тяжёлые» медиа-запросы (web/video/оригиналы) в минуту на IP
MEDIA_RATE_LIMIT=3000
# Превью (thumb/thumb_blur): лента запрашивает десятки картинок — корзина щедрее
MEDIA_PREVIEW_RATE_LIMIT=12000
# Посещения и события интерфейса (своя аналитика)
EVENTS_RATE_LIMIT=900
# Подписанные ссылки на премиум-превью: секрет (пусто — выключено). С секретом ссылку
# можно кэшировать в nginx, и превью отдаётся без обращения к Python (см. LAUNCH).
# Сгенерировать: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
ASSET_LINK_SECRET=
ASSET_LINK_TTL_MINUTES=60
# Кэш проверок доступа к файлу и JSON-ленты (снимает лишние SQL при листании)
MEDIA_ACCESS_CACHE_SECONDS=120
FEED_CACHE_SECONDS=45
# Разрешённые CORS-источники (не критично: фронт ходит через тот же origin)
API_CORS_ORIGINS=http://localhost
# Период пересчёта индекса популярности, в минутах
POPULARITY_RECALC_MINUTES=5

# ── Своя аналитика посещаемости (админка → «Статистика») ──────────
# Принимать хиты с сайта (POST /api/v1/hit); в таблице хранятся только хеши IP
ANALYTICS_ENABLED=1
# Сколько дней хранить сырые посещения (дальше чистит фоновая задача API)
ANALYTICS_RETENTION_DAYS=120
# Пауза между хитами, после которой визит считается новым, в минутах
ANALYTICS_SESSION_MINUTES=30
# Срок жизни счётчиков ошибок API в Redis (админка показывает 429/5xx)
ANALYTICS_ERROR_COUNTER_DAYS=14

# ── Админка: вход по email+паролю и восстановление ────────────────
# Кому разрешён вход в админку и восстановление пароля (через запятую).
# Аккаунты заводятся автоматически этим списком (или CLI: python -m src.cli.admin ensure).
ADMIN_EMAILS=admin@example.com,backup@example.com
# Срок жизни ссылки восстановления, минуты
ADMIN_RESET_TTL_MINUTES=30
# База для ссылок в письмах (домен сайта); пусто — берётся адрес запроса
PUBLIC_BASE_URL=https://example.com
# Публичный адрес сайта для SEO: canonical, sitemap.xml, robots.txt, Open Graph.
# Совпадает с PUBLIC_BASE_URL при обычном развёртывании.
SITE_URL=https://example.com
# Коды подтверждения панелей вебмастера (meta-тег в <head>); пусто — тег не выводится.
GOOGLE_SITE_VERIFICATION=
YANDEX_VERIFICATION=
# SMTP для писем восстановления, уведомлений о жалобах и обратной связи.
# Вариант «почта на своём домене» (рекомендуемый): Яндекс 360 для бизнеса.
#   1) в Яндекс 360 добавляем домен, подтверждаем TXT-записью, включаем «Почту для домена»;
#   2) в DNS добавляем MX, SPF (v=spf1 include:_spf.yandex.net ~all), DKIM и DMARC;
#   3) заводим ящики support@ и dmca@; в «Настройки → Почтовые программы» включаем
#      IMAP/SMTP и создаём «пароль приложения» (основной пароль для SMTP не подходит);
#   SMTP_HOST=smtp.yandex.ru  SMTP_PORT=465  SMTP_TLS=ssl
#   SMTP_USER=support@ваш-домен  SMTP_PASSWORD=<пароль-приложения>  SMTP_FROM=support@ваш-домен
# Запасной вариант — Gmail: «пароль приложения» (Google-аккаунт с 2FA):
#   https://myaccount.google.com/apppasswords  → 16 символов, пробелы убрать.
#   SMTP_HOST=smtp.gmail.com  SMTP_PORT=465  SMTP_TLS=ssl
#   SMTP_USER=you@gmail.com   SMTP_PASSWORD=<пароль-приложения>  SMTP_FROM=you@gmail.com
# Если SMTP_HOST пуст — письма не отправляются, восстановление только через CLI.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TLS=ssl
# Ежедневный отчёт на почту за прошедшие отчётные сутки (по МСК, 00:00–24:00):
# уходит сразу после 00:00 МСК (+DAILY_REPORT_DELAY_MINUTES) адресатам ниже.
DAILY_REPORT=true
# short — одна строка; standard — цифры и топ разделов; full — плюс ошибки прогонов
DAILY_REPORT_MODE=standard
# Кому отправлять (через запятую). Пусто — админам из ADMIN_EMAILS
DAILY_REPORT_EMAILS=
# Задержка после 00:00 МСК: парсер успевает дописать прогон
DAILY_REPORT_DELAY_MINUTES=5

# ── Локальный кэш медиа (диск сервера) ────────────────────────────
# S3 отдаёт ~3 МБ/с, диск — 500+ МБ/с: всё прочитанное остаётся на диске, поэтому
# повторные запросы (в том числе премиум-оригиналы) идут локально.
MEDIA_CACHE_ENABLED=1
MEDIA_CACHE_DIR=/data/cache
# Лимит кэша: 40 ГБ (вся библиотека ~8 ГБ) и не забивать диск ниже 10 ГБ свободных
MEDIA_CACHE_MAX_BYTES=42949672960
MEDIA_CACHE_MIN_FREE_BYTES=10737418240
# Параллельных загрузок при прогреве кэша (замер: 4 потока дают ~8 МБ/с из S3)
MEDIA_CACHE_WARM_WORKERS=4

# ── Парсер ────────────────────────────────────────────────────────
# Доски в формате JSON-массива
BOARDS_TO_PARSE=["b"]
# Задержка между запросами к форуму (защита от бана), сек
REQUEST_DELAY=0.5
# Коммит БД каждые N файлов внутри треда: файлы видны на сайте по мере скачивания,
# сбой теряет максимум N файлов (0 — коммит только после треда)
DB_COMMIT_EVERY_FILES=25
# Пауза между циклами парсинга, сек
PARSE_INTERVAL=60
# Максимальный размер файла, байт
MAX_FILE_SIZE=104857600
# Период сверки БД ↔ хранилище (reconciliation), мин (0 = только при старте)
RECONCILE_MINUTES=60
# Гигиена обхода: сколько проходов каталога подряд треда не было в каталоге → is_active=false
DEAD_THREAD_AFTER_MISSES=3
# Гигиена обхода: тред не сканировался дольше N часов → «просрочен» (чип в админке)
STALE_SCAN_HOURS=24
# Бюджет цикла: после N минут фаза B прерывается, остаток очереди — в следующем цикле (0 = без лимита)
PARSE_CYCLE_BUDGET_MINUTES=30
# Параллельные загрузки внутри треда (1 = строго последовательно)
MAX_PARALLEL_DOWNLOADS=2
# Ограничение памяти под «предзагрузку» пачки файлов, байт
PREFETCH_MAX_BYTES=67108864
# Параллельная выгрузка в S3 внутри треда: по умолчанию 1 (наш S3-эндпоинт
# троттлит одновременные загрузки — замер: 10.9 МБ/с против 3.0 МБ/с)
MAX_PARALLEL_UPLOADS=1

# ── Telegram: бот (доступ) и канал (витрина закрытого архива) ───────
# Токен бота и его ник: через бота выдаётся вход на сайт и (частично) продажи
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
# Канал-витрина: пост ведёт в бота, картинка размывается
TELEGRAM_CHANNEL=
# Кому уходит карантин автопоста (личка бота, узнаётся командой /id у бота):
# черновик поста приходит туда с кнопками «Опубликовать / Отклонить / Отложить»
TELEGRAM_ADMIN_CHAT_ID=
# Вход по ссылке из бота: сколько минут живёт ссылка и сколько секунд она ещё
# срабатывает после первого перехода (мессенджер открывает её сам, а человек —
# вторым; 0 — строгая одноразовость)
MAGIC_LINK_TTL_MINUTES=10
MAGIC_LINK_REUSE_SECONDS=90

# ── Крипта: Crypto Pay (CryptoBot) ──────────────────────────────────
# Токен приложения: @CryptoBot → команда /pay → Create App → API-токен.
# Суммы счёта берутся из тарифов (price_usdt_cents) и правятся в админке.
CRYPTOBOT_TOKEN=
# Тестовая сеть для отладки (testnet-pay.crypt.bot вместо pay.crypt.bot)
CRYPTOBOT_TESTNET=false
# В какой монете выставляем счёт
CRYPTOBOT_ASSET=USDT
# Сколько минут живёт счёт (сумма фиксируется на это время)
CRYPTOBOT_INVOICE_TTL_MINUTES=60

# ── Источник slivach (контейнер parser-slivach) ─────────────────────
# У каждого источника свой контейнер и своё расписание: 2ch ходит часто,
# сайт-источник — редко и вежливо (его настройки ниже, необязательны)
SLIVACH_REQUEST_DELAY=1.0
SLIVACH_PARSE_INTERVAL=300
SLIVACH_MAX_PARALLEL_DOWNLOADS=1

# ── Источник wayback (контейнер parser-wayback) ──────────────────────
# Архив web.archive.org: каталог треда берём из архивного catalog.json, а сами файлы
# качаем по одному из снапшотов, поэтому тут самая строгая вежливость.
#
# Было `PARSE_INTERVAL=3600` при бюджете цикла 30 минут: цикл забирал ~1 тред, упирался
# в бюджет и час простаивал — очередь в ~300 тредов не разбиралась за недели.
# Теперь пауза 5 минут (после завершения очереди) и бюджет 120 минут
# (`sources.budget_minutes` для wayback), задержка между запросами 0.8 с.
WAYBACK_REQUEST_DELAY=0.8
WAYBACK_PARSE_INTERVAL=300
# Параллельные загрузки из архива. Было 1 — по файлу за раз, из-за чего один тред
# (сотни файлов) занимал десятки минут, а весь цикл упирался в бюджет. 3 — архив
# терпит, а пропускная растёт в разы (следим за 429/503 в логах).
WAYBACK_MAX_PARALLEL_DOWNLOADS=3
# Каталог раздела берётся из архивного catalog.json. У раздела h его в архиве нет —
# планировщик такой раздел не обходит, его наполняют разовым HTML-импортом:
#   python -m src.tools.wayback_html_import --board h --host 2ch.hk --delay 0.8
# ── 4chan (источник chan4) ─────────────────────────────────────────────
# Официальный API: https://a.4cdn.org/{board}/catalog.json и /thread/{no}.json,
# медиа — https://i.4cdn.org/{board}/{tim}{ext}. Треды живут недолго (свой архив
# 4chan — несколько суток), поэтому прогон частый; API просит не чаще 1 запроса
# в секунду. Первая доска — /s/ (Sexy Beautiful Women); название/описание раздела
# и список разделов берутся из boards.json (кэш 5 минут).
CHAN4_REQUEST_DELAY=1.0
CHAN4_PARSE_INTERVAL=300
CHAN4_MAX_PARALLEL_DOWNLOADS=2
CHAN4_MAX_FILES_PER_POST=4
CHAN4_MAX_FILE_SIZE=104857600
# История, ушедшая с борды, добирается из сторонних архивов (FoolFuuka):
#   desuarchive.org   → /d/
#   archiveofsins.com → /h/, /u/, /hm/, /i/, /soc/
#   boards.fireden.net → /y/
# Инструмент импорта (по образцу wayback_import): src/tools/chan4_import.py
# Сверку данных (reconciliation) ведёт только контейнер 2ch: у остальных
# RECONCILE_MINUTES=-1 (задано в docker-compose.prod.yml)
