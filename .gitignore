# Виртуальное окружение
venv/
__pycache__/
*.pyc

# Медиафайлы (ваши скачанные файлы)
storage/media/

# Локальная БД (если используете SQLite)
*.db
*.sqlite3

# ── Файлы окружения ──────────────────────────────────────────────
# Реальные секреты — только в .env (и локальных вариантах), НЕ коммитим.
.env*
# Шаблоны без секретов — коммитим (исключения из правила .env*).
!.env.example
!.env.prod.example
!**/.env.example

# IDE (Visual Studio)
.vs/

# Node/Next.js (фронтенд)
node_modules/
web/.next/

# Логи
*.log
# артефакты прод-сервера
backups/
000;

# Архивы выкатки и git-bundle: переносятся вручную (scp), в репозитории не нужны.
# Раньше они попадали в коммиты и мешали разбираться с историей.
*.tar
*.tar.gz
*.bundle
*.pgc

# Локальные данные docker/dev
certbot/
docker-compose.override.yml

# Выгрузки для чтения/правки (описания разделов и т.п.): файл-артефакт, не код
board_descriptions.txt

# Исходник логотипа (4 МБ): из него собираются иконки скриптом make_icons.py.
# В репозиторий кладём уже уменьшенные icon.png / apple-icon.png / logo.png.
fav.png


# Внутренняя документация — не для публикации
docs/
DEPLOY.md
